{
    "compilerOptions": {
        "target": "ES2020",
        "module": "es2022",
        "moduleResolution": "bundler",
        "lib": [
            "ES2020",
            "DOM"
        ],
        "types": [
            "node"
        ],
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "outDir": "./dist",
        "skipLibCheck": true
    },
    "include": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "*.config.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "reports",
        "allure-results"
    ]
}